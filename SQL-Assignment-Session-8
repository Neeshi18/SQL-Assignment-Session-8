SELECT u.user_name, cs.segment_name, IFNULL(SUM(o.amount), 0) AS total_order_amount
FROM Users u
JOIN CustomerSegments cs
ON u.segment_id = cs.segment_id
LEFT JOIN Orders o
ON u.user_id = o.user_id
GROUP BY u.user_id, u.user_name, cs.segment_name;
